<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.dao.DichangongsiDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.entity.DichangongsiEntity" id="dichangongsiMap">
        <result property="gongsizhanghao" column="gongsizhanghao"/>
        <result property="gongsimingcheng" column="gongsimingcheng"/>
        <result property="mima" column="mima"/>
        <result property="tupian" column="tupian"/>
        <result property="lianxiren" column="lianxiren"/>
        <result property="lianxidianhua" column="lianxidianhua"/>
        <result property="gongsidizhi" column="gongsidizhi"/>
    </resultMap>

	<select id="selectListVO"
		resultType="com.entity.vo.DichangongsiVO" >
		SELECT * FROM dichangongsi  dichangongsi         
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectVO"
		resultType="com.entity.vo.DichangongsiVO" >
		SELECT  dichangongsi.* FROM dichangongsi  dichangongsi 	
 		<where> 1=1 ${ew.sqlSegment}</where>
	</select>

    <select id="selectListView"
		resultType="com.entity.view.DichangongsiView" >

		SELECT  dichangongsi.* FROM dichangongsi  dichangongsi 	        
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectView"
		resultType="com.entity.view.DichangongsiView" >
		SELECT * FROM dichangongsi  dichangongsi <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	


</mapper>
