<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.dao.FangwuchushouDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.entity.FangwuchushouEntity" id="fangwuchushouMap">
        <result property="fangwumingcheng" column="fangwumingcheng"/>
        <result property="fangwufengmian" column="fangwufengmian"/>
        <result property="fangwuleixing" column="fangwuleixing"/>
        <result property="fangwumianji" column="fangwumianji"/>
        <result property="shoujia" column="shoujia"/>
        <result property="fangwudizhi" column="fangwudizhi"/>
        <result property="huzhu" column="huzhu"/>
        <result property="lianxifangshi" column="lianxifangshi"/>
        <result property="fangwuxiangqing" column="fangwuxiangqing"/>
        <result property="chushouzhuangtai" column="chushouzhuangtai"/>
        <result property="gongsizhanghao" column="gongsizhanghao"/>
        <result property="gongsimingcheng" column="gongsimingcheng"/>
        <result property="storeupnum" column="storeupnum"/>
    </resultMap>

	<select id="selectListVO"
		resultType="com.entity.vo.FangwuchushouVO" >
		SELECT * FROM fangwuchushou  fangwuchushou         
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectVO"
		resultType="com.entity.vo.FangwuchushouVO" >
		SELECT  fangwuchushou.* FROM fangwuchushou  fangwuchushou 	
 		<where> 1=1 ${ew.sqlSegment}</where>
	</select>

    <select id="selectListView"
		resultType="com.entity.view.FangwuchushouView" >

		SELECT  fangwuchushou.* FROM fangwuchushou  fangwuchushou 	        
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectView"
		resultType="com.entity.view.FangwuchushouView" >
		SELECT * FROM fangwuchushou  fangwuchushou <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	

    <select id="selectValue" resultType="map" >
        SELECT ${params.xColumn}, ROUND(sum(${params.yColumn}),1) total FROM fangwuchushou
        <where> 1=1 ${ew.sqlSegment}</where>
        group by ${params.xColumn}
    </select>

    <select id="selectTimeStatValue" resultType="map" >
        <if test = 'params.timeStatType == "日"'>
                SELECT DATE_FORMAT(${params.xColumn},'%Y-%m-%d') ${params.xColumn}, sum(${params.yColumn}) total FROM fangwuchushou
                <where> 1=1 ${ew.sqlSegment}</where>
                group by DATE_FORMAT(${params.xColumn},'%Y-%m-%d')
        </if>
        <if test = 'params.timeStatType == "月"'>
                SELECT DATE_FORMAT(${params.xColumn},'%Y-%m') ${params.xColumn}, sum(${params.yColumn}) total FROM fangwuchushou
                <where> 1=1 ${ew.sqlSegment}</where>
                group by DATE_FORMAT(${params.xColumn},'%Y-%m')
        </if>
        <if test = 'params.timeStatType == "年"'>
                SELECT DATE_FORMAT(${params.xColumn},'%Y') ${params.xColumn}, sum(${params.yColumn}) total FROM fangwuchushou
                <where> 1=1 ${ew.sqlSegment}</where>
                group by DATE_FORMAT(${params.xColumn},'%Y')
        </if>
    </select>

    <select id="selectGroup" resultType="map" >
        SELECT ${params.column} , count(1) total FROM fangwuchushou
        <where> 1=1 ${ew.sqlSegment}</where>
        group by ${params.column}
    </select>




</mapper>
